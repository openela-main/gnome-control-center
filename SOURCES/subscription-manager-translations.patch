+
+#: panels/privacy/firmware-security/cc-firmware-security-page.ui:4
+msgid "Device Security"
+msgstr "장치 보안"
+
+#: panels/privacy/firmware-security/cc-firmware-security-page.ui:37
+msgid "Starting Device Security…"
+msgstr "장치 보안 시작하는 중…"
+
