From 36f84fea03cb3f457503c5b648ababb773d2b201 Mon Sep 17 00:00:00 2001
From: Felipe Borges <felipeborges@gnome.org>
Date: Thu, 9 Oct 2025 12:25:19 +0200
Subject: [PATCH 5/7] users, entry-feedback: Don't call a11y announce for the
 same text

Let's only announce when the text changes.

(cherry picked from commit 5cf9c7bd33ccddc3a3a57bbc6051f789df78a221)
---
 panels/system/users/cc-entry-feedback.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/panels/system/users/cc-entry-feedback.c b/panels/system/users/cc-entry-feedback.c
index b3847daee..5ed61aa76 100644
--- a/panels/system/users/cc-entry-feedback.c
+++ b/panels/system/users/cc-entry-feedback.c
@@ -213,8 +213,11 @@ cc_entry_feedback_update (CcEntryFeedback *self,
   g_return_if_fail (CC_IS_ENTRY_FEEDBACK (self));
 
   set_icon (self, icon_name);
-  gtk_label_set_label (self->label, text);
 
+  if (g_strcmp0 (text, gtk_label_get_text (self->label)) == 0)
