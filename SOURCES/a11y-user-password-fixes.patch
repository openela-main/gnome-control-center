From 25231873cdaa8761559e1b508430b8b6e8c47d34 Mon Sep 17 00:00:00 2001
From: Felipe Borges <felipeborges@gnome.org>
Date: Fri, 5 Sep 2025 12:04:36 +0200
Subject: [PATCH 1/7] users, entry-feedback: Pass text updates to
 Gtk.Accessible.announce

So that the user's screen reader announces the message.

This affects the usage/behavior of CcEntryFeedback on the "Change
Password" dialog and "Add User"/"Add Enterprise User" dialogs.

Fixes #3504

(cherry picked from commit 6dfab7c96a5979d2e5970b5673eec80c9d6c03bb)
---
 panels/system/users/cc-entry-feedback.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/panels/system/users/cc-entry-feedback.c b/panels/system/users/cc-entry-feedback.c
index daeba3d46..b3847daee 100644
--- a/panels/system/users/cc-entry-feedback.c
+++ b/panels/system/users/cc-entry-feedback.c
@@ -214,4 +214,8 @@ cc_entry_feedback_update (CcEntryFeedback *self,
 
   set_icon (self, icon_name);
   gtk_label_set_label (self->label, text);
+
+  gtk_accessible_announce (gtk_accessible_get_accessible_parent (GTK_ACCESSIBLE (self)),
+                           text,
+                           GTK_ACCESSIBLE_ANNOUNCEMENT_PRIORITY_MEDIUM);
 }
-- 
