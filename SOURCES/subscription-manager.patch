+
 struct _CcSystemPanel
 {
   CcPanel    parent_instance;
@@ -47,6 +49,8 @@ struct _CcSystemPanel
 
   CcSecureShellPage *secure_shell_dialog;
   AdwNavigationPage *software_updates_group;
