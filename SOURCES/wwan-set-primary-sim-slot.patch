@@ -0,0 +1,235 @@
+/* -*- Mode: C; tab-width: 2; indent-tabs-mode: nil; c-basic-offset: 2 -*- */
+/* cc-wwan-sim-slot-dialog.c
+ *
+ * Copyright (C) 2024 Josef Vincent Ouano <josef_ouano@yahoo.com.ph>
+ *
